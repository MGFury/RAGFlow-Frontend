# Copy to .env and fill in. The API key stays on the server and is never sent to the browser.
RAGFLOW_URL=http://localhost:9380
RAGFLOW_API_KEY=ragflow-xxxxxxxx

# Which dataset to read. Set the id, or leave it empty to look the dataset up by name.
DATASET_ID=
DATASET_NAME=shaul-files

PORT=3001
# Browser origin(s) allowed to call this API, comma separated.
CORS_ORIGIN=http://localhost:5173
